{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "miciano-wishlist",
  "account_id": "4e74d71c4e6a08b7febfb2a62cb259da",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{"type": "ESModule", "globs": ["**/*.js", "**/*.mjs"]}],
  "assets": {"directory": "./dist/client"},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "miciano-wishlist",
    "database_id": "9ede7a51-c140-44eb-b723-6f9053224261",
    "migrations_dir": "./drizzle"
  }],
  "routes": [{"pattern": "miciano.net", "custom_domain": true}],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": true}
}
